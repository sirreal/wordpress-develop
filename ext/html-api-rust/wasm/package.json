{
	"name": "wp-html-api-rust-wasm",
	"version": "0.1.0",
	"description": "WebAssembly build of the WordPress HTML API Rust implementation.",
	"type": "module",
	"main": "./wp-html-api-rust.js",
	"types": "./wp-html-api-rust.d.ts",
	"exports": {
		".": {
			"types": "./wp-html-api-rust.d.ts",
			"default": "./wp-html-api-rust.js"
